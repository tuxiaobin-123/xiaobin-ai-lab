# Runtime mode: mock runs immediately; ifind_http uses iFinD Quant HTTP API.
DATA_MODE=mock
WATCH_SYMBOLS=002261.SZ
QUOTE_POLL_SECONDS=1
DASHBOARD_REFRESH_SECONDS=1
MARKET_HOURS_ONLY=true
DB_PATH=data/financial_lab.duckdb
QUOTE_RETENTION_DAYS=30

# iFinD Quant HTTP API. Keep the refresh token local and never commit it.
IFIND_BASE_URL=https://quantapi.51ifind.com/api/v1
IFIND_REFRESH_TOKEN=
IFIND_QUOTE_INDICATORS=latest,open,high,low,volume,amount,changeRatio
# Optional JSON list required for automatic financial-field synchronization.
IFIND_FINANCIAL_INDICATORS_JSON=[]
# Map the iFinD output field names to the canonical rule-engine fields.
# Canonical keys: report_period,revenue_yoy,gross_margin_yoy_delta,cash_conversion,adjusted_profit
IFIND_FINANCIAL_FIELD_MAP_JSON={}

# B.AI event analysis. Use a newly rotated key only.
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai
BAI_MODEL=deepseek-v4-pro
BAI_AUTO_ANALYZE=true

# Event thresholds.
PRICE_CHANGE_ALERT=0.05
FAST_MOVE_ALERT=0.02
VOLUME_ACCELERATION_ALERT=3.0
MAX_DRAWDOWN_ALERT=-0.08
EVENT_COOLDOWN_SECONDS=900

# Enterprise WeChat webhook (optional).
WECOM_WEBHOOK_URL=

# SMTP email (optional).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
